<section class="custom-testimonials {{ section.settings.custom_class }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="testimonial-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="testimonial-grid">
      {% for block in section.blocks %}
        <div class="testimonial-card">
          <div class="stars">
            <svg width="152" height="24" viewBox="0 0 152 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z" fill="white"/>
              <path d="M44 0L46.6942 8.2918H55.4127L48.3593 13.4164L51.0534 21.7082L44 16.5836L36.9466 21.7082L39.6407 13.4164L32.5873 8.2918H41.3058L44 0Z" fill="white"/>
              <path d="M76 0L78.6942 8.2918H87.4127L80.3593 13.4164L83.0534 21.7082L76 16.5836L68.9466 21.7082L71.6407 13.4164L64.5873 8.2918H73.3058L76 0Z" fill="white"/>
              <path d="M108 0L110.694 8.2918H119.413L112.359 13.4164L115.053 21.7082L108 16.5836L100.947 21.7082L103.641 13.4164L96.5873 8.2918H105.306L108 0Z" fill="white"/>
              <path d="M140 0L142.694 8.2918H151.413L144.359 13.4164L147.053 21.7082L140 16.5836L132.947 21.7082L135.641 13.4164L128.587 8.2918H137.306L140 0Z" fill="white"/>
            </svg>
          </div>

          <div class="testimonial-text">
            {{ block.settings.review_text }}
          </div>

          <div class="testimonial-author">
            {% if block.settings.author_image != blank %}
              <img
                src="{{ block.settings.author_image | image_url: width: 80 }}"
                alt="{{ block.settings.author_name }}"
              >
            {% endif %}
            <span>{{ block.settings.author_name }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="custom_review_slider"></div>
  </div>
</section>

<style>
  .custom-testimonials {
    padding: 80px 0;
    background: #1D1D1D;
    color: #fff;
  }
  .testimonial-grid .slick-track {
      display: flex !important;
      gap: 23px !important;
  }
  .custom_review_slider ul.slick-dots {
      display: flex;
      align-items: center;
      justify-content: center;
      padding-left: 0;
      gap: 3px;
  }

  .custom_review_slider ul.slick-dots li {
      list-style: none;
      background: #d9d9d9;
      height: 8px;
      border-radius: 30px;
      width: 10px;
      cursor:pointer;
  }

  .custom_review_slider ul.slick-dots li button {
      opacity: 0;
      cursor: pointer;
      height: 10px;
  }

  .custom_review_slider ul.slick-dots li.slick-active {
      background: #fff;
      width: 25px;
  }

  .custom_review_slider {
      width: max-content;
      margin: 0 auto;
      padding-top: 30px;
  }
  {% comment %} .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
  } {% endcomment %}

  .testimonial-card {
    border: 1px solid #fff;
    border-radius: 20px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 260px;
    transition: 0.3s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-5px);
    border-color: #fff;
  }

  .stars {
    font-size: 18px;
    letter-spacing: 4px;
    margin-bottom: 15px;
  }
  .testimonial-card {
      margin-top: 5px;
      margin-bottom: 5px;
  }
  .testimonial-heading {
      text-align: center;
      font-size: 42px;
      margin-bottom: 50px;
      color: #fff;
      margin-top: 0;
  }
  .testimonial-text {
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.9;
    margin-bottom: 25px;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonial-author img {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    object-fit: cover;
  }

  .testimonial-author span {
    font-size: 17px;
    font-weight: 500;
  }

  @media(max-width: 1024px){
    .testimonial-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media(max-width: 600px){
    .testimonial-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hear from our clients"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "star_rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "richtext",
          "id": "review_text",
          "label": "Review Text",
          "default": "<p>Supply’s dedicated team keeps our freight moving on time without hassle. Their clear quick solutions have made them our trusted partner.</p>"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Image"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "John"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Review Testimonials"
    }
  ]
}
{% endschema %}
