<section class="maple-benefits-section">
  <div class="page-width">
    
    {% if section.settings.heading != blank %}
      <h2 class="maple-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subtext != blank %}
      <p class="maple-subtext">{{ section.settings.subtext }}</p>
    {% endif %}

    <div class="maple-benefits-grid">
      {% for block in section.blocks %}
        <div class="maple-benefit-item">
          
          {% if block.settings.icon != blank %}
            <div class="maple-icon">
              <img 
                src="{{ block.settings.icon | img_url: 'master' }}" 
                alt="{{ block.settings.title }}" 
                loading="lazy">
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <p class="maple-benefit-text">{{ block.settings.title }}</p>
          {% endif %}

        </div>
      {% endfor %}
    </div>

  </div>
</section>



{% schema %}
{
  "name": "Maple Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Benefits Of Pure Maple"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Naturally sweetened with 100% pure maple syrup from Quebec. No added artificial sugar, no coloring, no artificial flavors."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Text",
          "default": "Benefit Text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Benefits Section"
    }
  ]
}
{% endschema %}