      {{ section.settings.badge_text }}
    </div>

    <h2 class="hydration-heading">
      {{ section.settings.heading }}
    </h2>

    <div class="hydration-grid">
      {% for block in section.blocks %}
        <div class="hydration-card">
          <div class="video-card">
            {% if block.settings.image != blank %}
              <img
                class="video-thumbnail"
                src="{{ block.settings.image | img_url: 'master' }}"
                alt=""
              >
            {% endif %}

            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: class: 'custom-video', controls: false }}
            {% endif %}

            <div class="play-button">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="22" cy="22" r="22" fill="#E3E3E3" fill-opacity="0.7"/>
                <path d="M27.75 23.2988C28.7499 22.7215 28.7499 21.2785 27.75 20.7012L20.25 16.3711C19.25 15.7937 18 16.5152 18 17.6699V26.3301C18 27.4125 19.0984 28.1145 20.0596 27.7227L20.25 27.6289L27.75 23.2988Z" stroke="white"/>
              </svg>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .hydration-section {
    padding: 80px 0;
    background: #f3f3f3;
    text-align: center;
    overflow: hidden;
  }

  {% comment %} .hydration-section .page-width {
    max-width: 100%;
  } {% endcomment %}

  .hydration-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 16px;
    margin-bottom: 10px;
    color: #444;
  }
.hydration-heading {
    font-size: 45px;
    max-width: 550px;
    margin: 0 auto;
    padding-bottom: 60px;
}

  .hydration-card.slick-slide.slick-current.slick-active.slick-center {
      height: 730px;
  }
  .hydration-grid .slick-list {
    overflow: visible !important;
  }
  .hydration-grid .slick-track {
      display: flex !important;
      align-items: center;
      justify-content: center;
      gap: 20px !important;
  }
  .hydration-grid .slick-slide {
    transition: all 0.4s ease;

  }

  .hydration-grid .slick-center {
    opacity: 1;
    z-index: 2;
  }

  /* CARD */

  .hydration-card {
    height: 650px;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    position: relative;
  }

  .video-card {
    width: 100%;
    height: 100%;
    position: relative;
    cursor: pointer;
  }

  .video-thumbnail,
  .custom-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-video {
    display: none;
  }

  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 26px;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* MOBILE */

  @media (max-width: 768px) {
    .hydration-heading {
      font-size: 32px;
    }

    .hydration-card {
      height: 360px;
    }
    .hydration-grid .slick-track {
    gap: 15px !important;
}
  }
</style>

<script>
  function initHydrationSlider() {
    if ($('.hydration-grid').hasClass('slick-initialized')) {
      $('.hydration-grid').slick('unslick');
    }

    $('.hydration-grid').slick({
      centerMode: true,
      slidesToShow: 3,
      centerPadding: '120px',
      arrows: false,
      dots: false,
      speed: 3000,
      autoplay: true,
      infinite: true,
      responsive: [
        {
          breakpoint: 1050,
          settings: {
            slidesToShow: 3,
            centerPadding: '80px',
          },
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1,
            centerPadding: '60px',
          },
        },
      ],
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    initHydrationSlider();

    document.querySelectorAll('.video-card').forEach(function (card) {
      card.addEventListener('click', function () {
        const video = card.querySelector('.custom-video');
        const thumbnail = card.querySelector('.video-thumbnail');
        const playBtn = card.querySelector('.play-button');

        document.querySelectorAll('.custom-video').forEach(function (v) {
          v.pause();
          v.style.display = 'none';
        });

        document.querySelectorAll('.video-thumbnail').forEach(function (img) {
          img.style.display = 'block';
        });

        document.querySelectorAll('.play-button').forEach(function (btn) {
          btn.style.display = 'flex';
        });

        video.style.display = 'block';
        thumbnail.style.display = 'none';
        playBtn.style.display = 'none';
        video.play();
      });
    });
  });

  document.addEventListener('shopify:section:load', function () {
    initHydrationSlider();
  });
</script>

{% schema %}
{
  "name": "Real People Hydration",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "Over 10,000 happy customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Real People, Real Hydration"
    }
  ],
  "blocks": [
    {
      "type": "video_block",
      "name": "Video Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Upload Video"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Custom Video"
    }
  ]
}
{% endschema %}
